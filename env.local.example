# Contact API: server-side variables. Set in Cloudflare Worker runtime variables/secrets.
# Copy to .env.local for local Next.js development. Never commit real credentials.
# Enable mandatory hCaptcha in Web3Forms > Form Settings > Spam & Security.
# WEB3FORMS_ACCESS_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ALLOWED_ORIGINS=http://localhost:3000,https://www.urcrobotics.com,https://urcrobotics.com
# CONTACT_SKIP_RATE_LIMIT=true
